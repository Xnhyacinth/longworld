# Aligned SFT recipe for method comparison.
# Sourced by scripts/train_swift.sh and scripts/train_baselines_128k.sh.
# Method yamls may repeat these values; the launcher CLI overrides so they cannot drift.
#
# wandb: entity/project live in gitignored .env; defaults here match that file.
#   WANDB_ENTITY=wyncke  WANDB_PROJECT=longworld  WANDB_API_KEY=...
# 128k trio (ACC / LongTrace / LongMIT) also sets WANDB_RUN_GROUP so they plot together.

# --- wandb (all ms-swift runs) ---
WANDB_ENTITY="${WANDB_ENTITY:-wyncke}"
WANDB_PROJECT="${WANDB_PROJECT:-longworld}"
REPORT_TO="${REPORT_TO:-wandb}"

# --- optimizer / schedule (all methods) ---
LEARNING_RATE="${LEARNING_RATE:-1.0e-5}"
LR_SCHEDULER_TYPE="${LR_SCHEDULER_TYPE:-cosine}"
WARMUP_RATIO="${WARMUP_RATIO:-0.05}"
SEED="${SEED:-42}"
MAX_GRAD_NORM="${MAX_GRAD_NORM:-1.0}"
TUNER_TYPE="${TUNER_TYPE:-full}"
PACKING="${PACKING:-false}"
PADDING_FREE="${PADDING_FREE:-true}"
USE_LOGITS_TO_KEEP="${USE_LOGITS_TO_KEEP:-false}"
GRADIENT_CHECKPOINTING="${GRADIENT_CHECKPOINTING:-true}"
ADD_NON_THINKING_PREFIX="${ADD_NON_THINKING_PREFIX:-true}"

# --- logging / ckpt (all methods) ---
LOGGING_STEPS="${LOGGING_STEPS:-5}"
SAVE_STEPS="${SAVE_STEPS:-100}"
SAVE_TOTAL_LIMIT="${SAVE_TOTAL_LIMIT:-2}"
SAVE_ONLY_MODEL="${SAVE_ONLY_MODEL:-false}"

# --- 128k related-work baselines (ACC, LongTrace, LongMIT) ---
# Same compute: GBS 16, 680 steps ≈ one ACC epoch (10802/16). Paper is 4 epochs.
# ms-swift Ulysses: true GBS = per_device * accum * (nproc / SP).
# 2 GPU + SP=2 => DP=1, micro=1, accum=16 => GBS 16.
# Official Qwen3.5 SP recipe: flash_attn, padding_free, use_logits_to_keep false, no DeepSpeed.
# Qwen3.5 GDN requires flash-linear-attention in the swift venv (not liger; qwen3_5 unsupported).
MAX_LENGTH_128K="${MAX_LENGTH_128K:-133120}"
MAX_STEPS_128K="${MAX_STEPS_128K:-680}"
NUM_TRAIN_EPOCHS_128K="${NUM_TRAIN_EPOCHS_128K:-1.0}"
EVAL_STEPS="${EVAL_STEPS:-100}"
EVAL_STRATEGY_128K="${EVAL_STRATEGY_128K:-steps}"
GBS="${GBS:-16}"
SEQUENCE_PARALLEL_SIZE="${SEQUENCE_PARALLEL_SIZE:-2}"
CELOSS_PARALLEL_SIZE="${CELOSS_PARALLEL_SIZE:-1024}"
DEEPSPEED="${DEEPSPEED:-none}"
ATTN_IMPL="${ATTN_IMPL:-flash_attn}"
WANDB_RUN_GROUP_128K="${WANDB_RUN_GROUP_128K:-longworld-128k-sft}"
