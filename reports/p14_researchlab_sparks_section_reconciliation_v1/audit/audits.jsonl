{"attestation": {"digest": "b1c840c2cdb564a9ce04a5073070aaa1f1047076b68882005d72ae26461a7457", "environment": "probe", "key_id": "probe-auditor-7e6285a97ae06a6a55d3992764711c3b", "purpose": "dense_retrieval_audit", "role": "auditor", "scheme": "hmac-sha256-v2"}, "candidate_sha256": "bf594048f916e27f896b85019ab8e719c016d0cca3b0c5e47b1cbffa1381b812", "embedding_topk_insufficient": true, "expected_answer": "v5 revision_of v4 || We use AGI to refer to systems that demonstrate broad capabilities of intelligence, including reasoning, planning, and the ability to learn from experience, and with these capabilities at or above human-level. || A key measure of intelligence is the ability to synthesize information from different domains or modalities and the capacity to apply knowledge and skills across different contexts or disciplines. || As it seems, however, \\DV \\ is still quite far from the level of experts, and does not have the capacity required to conduct mathematical research. || While \\DV\\ is obviously not embodied,  we explore whether it can engage in embodied interaction by using natural language as a text interface to various simulated or real-world environments. || Theory of mind is the ability to attribute mental states such as beliefs, emotions, desires, intentions, and knowledge to oneself and others, and to understand how they affect behavior and communication~\\cite{wellman1992child}. || We are able to obtain a total of 6764 sentences. || This raises an important shortcoming of the current metrics: they tend to capture \\textit{semantic} similarities within statements, and rely primarily on word or sentence-level similarity metrics which capture \\textit{syntax}. || These examples illustrate some of the limitations of the next-word prediction paradigm, which manifest as the model's lack of planning, working memory, ability to backtrack, and reasoning abilities. || Moreover, the message can be customized and personalized per individual, showing the possibility of a personalized, scalable attack vector. || Overall, elucidating the nature and mechanisms of AI systems such as {\\DV} is a formidable challenge that has suddenly become important and urgent.", "k": 3, "local_probe_trust_isolation": "non_independent_local_diagnostic", "model": {"backend": "sentence-transformers-6.0.0", "chunking": {"aggregation": "max_similarity", "max_tokens": 192, "overlap_tokens": 32, "strategy": "tokenizer_token_windows"}, "model_id": "sentence-transformers/all-MiniLM-L6-v2", "provider": "huggingface", "revision": "1110a243fdf4706b3f48f1d95db1a4f5529b4d41", "score_metric": "dot_product"}, "near_dup_sentence_ratio": 0.0034, "query_id": "lab142303127-nacrebench-98:paper_revision_section_reconciliation:fdf9a1dfdc5e:64k:first:middle:64k", "ranker_type": "dense_embedding", "ranking_sha256": "74a0c2c7bc135a6c3da3d8652203a1a76a812915177e0f8ec512063a5cb1356f", "schema_version": "train-ready-promotion-v2", "source_workflow_bundle": {"adapter_revision": "sourceworkflow@2", "binding_digest": "808d6729058f159e2964ea69cd5ad7e0e9f557f2e0d11bdc0a19ed2a6c55c7fb", "schema_version": "longworld.source-workflow-bundle.v1", "sha256": "97b35381a2dbd429b9a26b46fdd9f59e75042f5d2dfe8ccc4c373c70fee795ec"}, "strict_growth_metrics": {"authentic_source_relation_edges": [{"child_record_id": "arxiv:2303.12712v5", "child_source_url": "https://arxiv.org/abs/2303.12712v5", "parent_record_id": "arxiv:2303.12712v4", "parent_source_url": "https://arxiv.org/abs/2303.12712v4", "relation": "revision_of", "relation_provenance": "authentic_source"}], "graph": {"n_essential_events": 14, "proof_depth": 4}, "semantic_growth_group_id": "3b8da0c31d5de8bb1f20", "semantic_tokens": {"causal_supporting": 414, "event_bearing": 65140, "generic_background": 0, "internal": 65140, "proof_bearing": 64010}, "strict_support_event_count": 15}, "strict_replay_answer": "unknown", "strict_replay_prefix_answers": ["unknown", "unknown", "unknown"], "strict_replay_revision": "longworld-strict-replay-v